# 複製這個檔案成 .env.local 再填值。.env.local 不會進版控。

# Supabase → Project Settings → Database → Connection string → Transaction pooler（port 6543）
# 記得把網址裡的 [YOUR-PASSWORD] 換成建立專案時設的資料庫密碼
DATABASE_URL=

# 自己設一組登入密碼，手機和電腦都用這組進系統
APP_PASSWORD=

# cookie 簽章用的隨機字串，用 `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` 產生
AUTH_SECRET=

# 口語輸入（網頁與 LINE 都用這個解析句子）
DEEPSEEK_API_KEY=

# ── 以下是 LINE 記帳用的，不用 LINE 的話可以全部留空 ───────────────
# LINE Developers Console → 你的 Messaging API channel

# Basic settings 分頁 → Channel secret（拿來驗證 webhook 真的來自 LINE）
LINE_CHANNEL_SECRET=

# Messaging API 分頁 → Channel access token (long-lived) → Issue
LINE_CHANNEL_ACCESS_TOKEN=

# Basic settings 分頁 → Your user ID（U 開頭那串）。
# 只有這個人傳的訊息會被記帳，其他人一律不理
LINE_USER_ID=

# 只有跑驗收腳本時才設。指到本機的假伺服器，測試才不會真的發訊息出去。
# 正式環境（Vercel）上一定要留空，不然訊息會送到不存在的地方
LINE_API_BASE=

# 每日提醒端點的密碼，隨機 16 字以上。設在 Vercel 上，Vercel 會自動
# 用它當 Authorization 標頭來呼叫 /api/cron/reminder。沒設的話那支端點一律拒絕
CRON_SECRET=
